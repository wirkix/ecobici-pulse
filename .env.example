# --- Kafka ---
# Set automatically by docker-compose.yml for the poller/consumer
# containers; only needed here if you run poller/main.py or
# consumer/main.py directly on the host (outside Docker) against the
# compose-managed broker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- TimescaleDB (self-hosted, local docker-compose or the production VM) ---
# Matches the credentials baked into docker-compose.yml's timescaledb
# service. Only needed on the host if running consumer/main.py outside
# Docker.
TIMESCALE_DSN=postgresql://ecobici:ecobici@localhost:5433/ecobici_pulse

# --- Supabase (new project, separate from professional-website's) ---
# Dashboard -> Project Settings -> API for the URL/keys. Used for the
# current-state snapshot table and Realtime broadcast -- see
# db/supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard -> Connect -> "Session pooler" tab -- NOT the default "Direct
# connection" string. The direct connection is IPv6-only (unless you pay
# for the IPv4 add-on), and most cloud VMs -- including the Oracle Cloud
# one this project deploys to -- have no IPv6 egress by default, so the
# consumer fails with "Network is unreachable" using it. See CLAUDE.md's
# "Known gotchas" for detail. Looks like:
# postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_DSN=

# --- Next.js app (web/) ---
# Publishable, safe to expose client-side -- same pattern as
# professional-website's Supabase client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
